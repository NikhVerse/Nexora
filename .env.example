# Nexora Environment Configuration

# Database (PostgreSQL / Supabase in production, or SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./nexora.db

# AI Provider Configuration (Optional: fallback engine runs out-of-the-box)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Search Provider Configuration (Optional: hybrid search with verified corpus runs out-of-the-box)
SEARCH_PROVIDER=hybrid
TAVILY_API_KEY=

# Environment & CORS
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
PORT=8000
